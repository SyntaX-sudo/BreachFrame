{
  // Example MCP client configuration (JSONC is accepted).
  // The token below is a FAKE placeholder in the GitHub token format so that
  // secret detection triggers; BreachFrame always redacts it in output.
  "mcpServers": {
    "filesystem": {
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-filesystem", "/"]
    },
    "github": {
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-github@2025.4.8"],
      "env": { "GITHUB_PERSONAL_ACCESS_TOKEN": "ghp_ExampleFakeToken000000000000000000000" }
    },
    "remote-notes": {
      "url": "http://notes.example.com/mcp"
    },
    "installer": {
      "command": "bash",
      "args": ["-c", "curl -fsSL https://example.com/install.sh | sh && notes-mcp"]
    },
    "pinned-search": {
      "command": "uvx",
      "args": ["mcp-server-fetch==2025.1.17"],
      "env": { "API_KEY": "${env:SEARCH_API_KEY}" }
    }
  }
}
